# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# USDT Payment Verification (TRON / TRC-20)
USDT_WALLET_ADDRESS="your-bybit-trc20-wallet-address"
TRON_API_KEY="your-trongrid-or-tronscan-api-key"
TRON_NETWORK="mainnet" # or shasta/nile for testnet
STRICT_ONCHAIN_VERIFICATION=true
